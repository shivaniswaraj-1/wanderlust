<% layout("/layouts/boilerplate") -%>

<div class="row mt-4 mb-5">
  <div class="col-12 col-lg-10 offset-lg-1">
    <h3 class="fw-bold mb-4">My Trips</h3>

    <% if (bookings.length === 0) { %>
      <p class="text-muted">
        You haven't booked any stays yet.
        <a href="/listings">Browse listings</a> to plan your next trip.
      </p>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        <% for (let booking of bookings) { %>
          <% if (!booking.listing) { continue; } %>
          <div class="col">
            <div class="card trip-card h-100">
              <img
                src="<%= (booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
                class="card-img-top"
                alt="listing image"
              />
              <div class="card-body">
                <h5 class="card-title">
                  <a href="/listings/<%= booking.listing._id %>" class="text-reset text-decoration-none">
                    <%= booking.listing.title %>
                  </a>
                </h5>
                <p class="card-text text-muted mb-1"><%= booking.listing.location %>, <%= booking.listing.country %></p>
                <p class="card-text mb-1">
                  <%= booking.checkIn.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                  &rarr;
                  <%= booking.checkOut.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                </p>
                <p class="card-text fw-semibold">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %> total</p>
              </div>
              <div class="card-footer bg-transparent border-0 pt-0">
                <form method="post" action="/trips/<%= booking._id %>?_method=DELETE">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-outline-dark">Cancel booking</button>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
