<% layout("/layouts/boilerplate") -%>

<%
  // Each entry: [category slug used in the DB/query string, icon class, label]
  const filterOptions = [
    ["trending",      "fa-solid fa-fire",             "Trending"],
    ["rooms",         "fa-solid fa-bed",              "Rooms"],
    ["iconic-cities", "fa-solid fa-mountain-city",    "Iconic cities"],
    ["mountains",     "fa-solid fa-mountain",         "Mountains"],
    ["castles",       "fa-brands fa-fort-awesome",    "Castles"],
    ["amazing-pools", "fa-solid fa-person-swimming",  "Amazing Pools"],
    ["camping",       "fa-solid fa-campground",       "Camping"],
    ["farm",          "fa-solid fa-cow",              "Farm"],
    ["arctic",        "fa-solid fa-snowflake",        "Arctic"],
    ["domes",         "fa-solid fa-igloo",            "Domes"],
    ["boats",         "fa-solid fa-ship",             "Boats"],
  ];
%>
<%# Filter bar / tax-toggle styling lives in /css/style.css (shared, with a
    mobile media query) rather than duplicated here. Clicking the active
    filter again clears it (links back to /listings with no category). %>
<div id="filters">
  <% filterOptions.forEach(([slug, icon, label]) => { %>
    <a
      class="filter <%= activeCategory === slug ? 'filter-active' : '' %>"
      href="<%= activeCategory === slug ? '/listings' : '/listings?category=' + slug %>"
    >
      <div><i class="<%= icon %>"></i></div>
      <p><%= label %></p>
    </a>
  <% }) %>
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<% if (activeCategory && allListing.length === 0) { %>
  <p class="text-muted text-center mt-5">
    No listings found in this category yet.
    <a href="/listings">Clear filter</a>
  </p>
<% } %>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mt-3">
  <% for (let list of allListing) { %>
    <a href="/listings/<%= list._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= (list.image && list.image.url) ? list.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
          class="card-img-top"
          alt="listing image"
          style="height: 20rem; border-radius: 1rem; object-fit: cover;"
        >
        <div class="card-body">
          <p class="card-text">
            <b><%= list.title %></b><br>
            &#8377; <%= (Number(list.price) || 0).toLocaleString("en-IN") %> / night
            <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      info.style.display = (info.style.display !== "inline") ? "inline" : "none";
    }
  });
</script>
